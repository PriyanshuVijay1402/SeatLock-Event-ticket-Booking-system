# Copy to .env for running outside docker (the app reads process.env only;
# use `node --env-file=.env` or export these in your shell).
DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing
REDIS_URL=redis://localhost:6379
PORT=4000

# --- concurrency knobs (see DESIGN.md) ---
LOCK_STRATEGY=pessimistic          # pessimistic | optimistic
CHECKOUT_MODE=queue                # queue | direct
BOOKING_ISOLATION=READ COMMITTED   # READ COMMITTED | REPEATABLE READ | SERIALIZABLE
DB_POOL_SIZE=10
WORKER_CONCURRENCY=8
QUEUE_RATE_PER_SEC=500
MAX_QUEUE_DEPTH=5000
HOLD_TTL_SECONDS=300
MAX_TX_RETRIES=5

# --- rate limiting (fixed window) ---
RATE_LIMIT_WINDOW_SEC=10
RATE_LIMIT_USER_MAX=20
RATE_LIMIT_IP_MAX=10000
