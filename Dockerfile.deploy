# Single-container build for free hosting (Render, Koyeb, ...): the React
# site + API + queue worker in one process. See RUNNING.md "Deploy for free".
# Local development still uses docker-compose.yml (separate containers).

FROM node:22-alpine AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM node:22-alpine AS backend
WORKDIR /app
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    STATIC_DIR=/app/public \
    PROCESS_ROLE=all
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev
COPY --from=backend /app/dist ./dist
COPY backend/db ./db
COPY --from=frontend /frontend/dist ./public
# Hosts inject PORT; config.ts reads it (default 4000).
EXPOSE 4000
CMD ["node", "dist/all.js"]
